# Stray GOPATH / Go module cache artifacts that have accidentally been
# committed in the past (e.g. a self-referential gitlink under
# root/src/github.com/<owner>/<repo> with no matching .gitmodules entry).
# Keep local GOPATH/Go build caches out of version control.
/root/

# Kernel module build output
*.o
*.ko
*.mod
*.mod.c
*.symvers
*.order
*.o.d
*.o.cmd
.*.cmd
.tmp_versions/

# lkm4ctr_checker userspace binary build output
lkm4ctr_checker/lkm4ctr_checker
modules.order

# Local scratch dirs used for lkm4ctr QEMU boot-test iteration
# (staged built .ko output + an extracted/repacked test ramdisk root).
# Never commit these; they are large, throwaway, and regenerated on demand.
/modules-out/
/ramdisk-root/
/plans/