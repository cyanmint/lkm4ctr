#!/busybox sh
# shellcheck shell=dash
# Public Domain (AI-generated; no copyright subsists in this content).

mkdir -p /dev /proc /sys /newroot
/busybox mount -t proc proc /proc
/busybox mount -t sysfs sysfs /sys
/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
/busybox mdev -s

if [ ! -e /dev/loop-control ]; then
	/busybox mknod -m 0600 /dev/loop-control c 10 237
fi
if [ ! -e /dev/device-mapper ]; then
	/busybox mknod -m 0600 /dev/device-mapper c 10 236
fi
/busybox mkdir -p /dev/block
loop_number=0
while [ "$loop_number" -lt 64 ]; do
	if [ ! -e "/dev/block/loop$loop_number" ]; then
		/busybox mknod -m 0600 "/dev/block/loop$loop_number" b 7 "$loop_number"
	fi
	loop_number=$((loop_number + 1))
done

attempt=0
while [ ! -b /dev/sda ] || [ ! -b /dev/sdb ]; do
	/busybox mdev -s
	if [ -b /dev/sda ] && [ -b /dev/sdb ]; then
		break
	fi
	if [ "$attempt" -ge 30 ]; then
		echo "REDROID_TEST_FAILED: Disk A/B device nodes did not appear"
		/busybox poweroff -f
		exit 1
	fi
	/busybox sleep 1
	attempt=$((attempt + 1))
done

if ! /busybox mount -t ext4 -o rw /dev/sda /newroot; then
	echo "REDROID_TEST_FAILED: could not mount Disk A from /dev/sda"
	/busybox poweroff -f
	exit 1
fi

if [ ! -s /lkm4ctr.ko ] || [ ! -x /lkm4ctr_checker ]; then
	echo "REDROID_TEST_FAILED: module/checker are missing from the injected initramfs"
	/busybox poweroff -f
	exit 1
fi
mkdir -p /newroot/system/bin
if ! /busybox cp /lkm4ctr.ko /newroot/system/bin/lkm4ctr.ko ||
   ! /busybox cp /lkm4ctr_checker /newroot/system/bin/lkm4ctr_checker ||
   ! /busybox chmod 0644 /newroot/system/bin/lkm4ctr.ko ||
   ! /busybox chmod 0755 /newroot/system/bin/lkm4ctr_checker; then
	echo "REDROID_TEST_FAILED: could not copy module/checker to Disk A"
	/busybox poweroff -f
	exit 1
fi

if ! /busybox sh /lkm4ctr-early-devices.sh /newroot/dev /busybox --scsi; then
	echo "REDROID_TEST_FAILED: could not prepare Disk A device nodes"
	/busybox poweroff -f
	exit 1
fi

fail() {
	echo "REDROID_TEST_FAILED: $*"
	/busybox poweroff -f
	exit 1
}

detach_initramfs_mount() {
	mountpoint=$1
	echo "REDROID_TEST: detaching initramfs mount $mountpoint"
	if /busybox grep -q " $mountpoint " /proc/mounts; then
		if ! /busybox umount "$mountpoint"; then
			fail "could not detach initramfs mount $mountpoint"
		fi
	fi
	echo "REDROID_TEST: detached initramfs mount $mountpoint"
}

# Android first-stage init owns its /dev, /proc, and /sys setup.
echo 1000 > /proc/sys/kernel/printk_ratelimit_burst 2>/dev/null || true
detach_initramfs_mount /dev
detach_initramfs_mount /sys
detach_initramfs_mount /proc

echo "REDROID_TEST: switching to the Redroid rootfs on Disk A"
exec /busybox switch_root /newroot /init
